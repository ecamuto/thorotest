# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite (no extra setup) — fine for evaluation and small installs.
# For production use PostgreSQL: SQLite allows a single writer at a time.
DATABASE_URL=sqlite:///./testhub.db

# PostgreSQL — recommended for production
# DATABASE_URL=postgresql://thorotest:thorotest@localhost:5432/thorotest

# Password for the docker-compose Postgres service (and its DATABASE_URL).
# REQUIRED for any non-local docker deploy — the compose fallback is weak.
# POSTGRES_PASSWORD=

# MySQL / MariaDB
# DATABASE_URL=mysql+pymysql://thorotest:thorotest@localhost:3306/thorotest

# ─── Shared runtime state (Redis) ─────────────────────────────────────────────
# Optional for single-process local development. The production Docker Compose
# stack supplies its internal Redis URL automatically. Set REDIS_REQUIRED=1 on
# any multi-worker/replica deployment so loss of shared state fails readiness
# instead of silently weakening coordination or rate limits.
# REDIS_URL=redis://localhost:6379/0
# REDIS_REQUIRED=0
# REDIS_KEY_PREFIX=thorotest
# REDIS_CONNECT_TIMEOUT_SECONDS=2
# REDIS_SOCKET_TIMEOUT_SECONDS=2
# REDIS_JOB_TTL_SECONDS=86400

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Signs session JWTs and encrypts stored TOTP secrets. There is no
# default and no placeholder: the app refuses to start without it, because a
# shared or guessable key lets anyone forge an admin session. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# install.sh writes a fresh key here for you; set it yourself for Docker.
SECRET_KEY=

# Set ENVIRONMENT=production on any real deployment. It turns on prod-only
# refusals (DEMO_MODE off, SQLite warning) — it is NOT what protects SECRET_KEY,
# which is enforced in every environment.
# ENVIRONMENT=production

# CORS allowed origins. Comma-separated list, or "*" for any (dev only).
# Defaults to TESTHUB_BASE_URL when unset (correct for same-origin deploys).
# ALLOWED_ORIGINS=https://demo.example.com

# ─── Self-registration ────────────────────────────────────────────────────────
# Off by default: POST /api/auth/register returns 403 and OAuth signs in existing
# users but never provisions new ones. Admins create accounts from Configure ▸
# Users. Turn this on ONLY for a public demo or a trusted network — anyone who
# can reach the instance can then create an account (read-only `viewer` role).
# ALLOW_OPEN_REGISTRATION=1

# ─── First-boot admin ─────────────────────────────────────────────────────────
# Password for the seeded admin@localhost account on a fresh install. When
# unset, a random password is generated and printed ONCE in the server log
# (under DEMO_MODE the demo default "admin" is used instead).
# ADMIN_INITIAL_PASSWORD=

# ─── Demo mode ────────────────────────────────────────────────────────────────
# When enabled, opening a running run's live view drives it to completion with
# randomly generated results (for demos/screenshots only). Fabricates data —
# never enable in production; the app refuses to boot if ENVIRONMENT=production.
# DEMO_MODE=1

# ─── System email (password reset) ───────────────────────────────────────────
# Outbound SMTP for account emails. Unset SMTP_HOST = password-reset emails are
# skipped (the API still responds normally; nothing is leaked to the client).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER):
SMTP_FROM=
# STARTTLS is on by default for port 587; port 465 uses implicit TLS.
# SMTP_STARTTLS=0

# ─── OAuth — Phase 14 ─────────────────────────────────────────────────────────
# Public base URL (must match provider callback registrations):
TESTHUB_BASE_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App callback URL (register in GitHub Developer settings):
#   {TESTHUB_BASE_URL}/api/auth/oauth/github/callback
# Google OAuth client Authorized redirect URI (Google Cloud Console):
#   {TESTHUB_BASE_URL}/api/auth/oauth/google/callback

# Auto-sync all Jira integrations every N minutes (0 = disabled).
# Needs outbound reachability to Jira Cloud; no public endpoint required.
JIRA_AUTOSYNC_MINUTES=0
