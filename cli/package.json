{
  "name": "@thorotest/cli",
  "version": "0.2.0",
  "description": "Command-line client for ThoroTest — lint, sync, and inspect tests from the terminal or CI.",
  "bin": {
    "thorotest": "bin/thorotest.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.js' --test-coverage-lines=95 --test-coverage-branches=70 --test-coverage-functions=90 test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecamuto/thorotest.git",
    "directory": "cli"
  },
  "license": "SEE LICENSE IN ../LICENSE"
}
